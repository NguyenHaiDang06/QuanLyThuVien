<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Thư Viện Trực Tuyến</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" href="/KhachHang"><i class="bi bi-book-half"></i> Thư Viện Trực Tuyến</a>
                <div class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item"><a class="nav-link text-white" href="/KhachHang">Trang chủ</a></li>
                        <li class="nav-item"><a class="nav-link text-white" href="/KhachHang">Tra cứu sách</a></li>
                    </ul>
                    <a href="/" class="btn btn-outline-light btn-sm">Đăng nhập Quản trị</a>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-4 mb-5">
        <main role="main">
            @RenderBody()
        </main>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>