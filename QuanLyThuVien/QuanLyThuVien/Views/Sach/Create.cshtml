@model QuanLyThuVien.Models.Book
@{
    Layout = "_MyLayout";
    ViewData["Title"] = "Thêm sách mới";
}

<div class="card mt-3">
    <div class="card-header"><h3 class="card-title">Thêm đầu sách mới</h3></div>
    <div class="card-body">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">Tên sách</label>
                <input asp-for="Title" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Author" class="form-label">Tác giả</label>
                <input asp-for="Author" class="form-control" required />
            </div>
            <div class="mb-3">
                <label asp-for="Category" class="form-label">Thể loại</label>
                <input asp-for="Category" class="form-control" />
            </div>
            <div class="mb-3">
                <label asp-for="Quantity" class="form-label">Số lượng</label>
                <input asp-for="Quantity" type="number" class="form-control" min="1" value="1" required />
            </div>
            <button type="submit" class="btn btn-success">Lưu sách</button>
            <a href="/Sach" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>