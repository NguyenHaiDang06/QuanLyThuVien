@{ Layout = "_MyLayout"; ViewData["Title"] = "Báo cáo Thống kê"; }

<div class="row mt-3">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white"><h4 class="mb-0">Sách theo Thể loại</h4></div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>Thể loại</th><th>Tổng số lượng</th></tr></thead>
                    <tbody>
                        @foreach (var item in ViewBag.BooksByCategory)
                        {
                            <tr><td>@item.Key</td><td><span class="badge bg-primary rounded-pill">@item.Value</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark"><h4 class="mb-0">Tình trạng Mượn - Trả</h4></div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light"><tr><th>Trạng thái phiếu</th><th>Số lượng</th></tr></thead>
                    <tbody>
                        @foreach (var item in ViewBag.BorrowStats)
                        {
                            <tr><td>@item.Key</td><td><span class="badge bg-danger rounded-pill">@item.Value</span></td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>