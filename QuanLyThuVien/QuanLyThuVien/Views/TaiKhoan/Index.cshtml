@model IEnumerable<QuanLyThuVien.Models.Account>
@{ Layout = "_MyLayout"; ViewData["Title"] = "Quản lý Tài khoản"; }
<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Hệ thống Tài khoản</h3>
        <a asp-action="Create" class="btn btn-success btn-sm ms-auto"><i class="bi bi-plus-circle"></i> Cấp tài khoản</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr><th>ID</th><th>Tên đăng nhập</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    foreach (var item in Model) {
                        <tr>
                            <td>@item.Id</td><td>@item.Username</td>
                            <td><span class="badge bg-info text-dark">@item.Role</span></td>
                            <td>@(item.IsActive ? "Hoạt động" : "Bị khóa")</td>
                            <td>
                                <a asp-controller="TaiKhoan" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Sửa</a>
                                <a asp-controller="TaiKhoan" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Xóa tài khoản này?');">Xóa</a>
                            </td>
                        </tr>
                    }
                } else {
                    <tr><td colspan="5" class="text-center py-3">Chưa có tài khoản nào.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>