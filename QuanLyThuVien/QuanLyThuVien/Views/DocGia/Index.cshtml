@model IEnumerable<QuanLyThuVien.Models.Reader>
@{
    Layout = "_MyLayout";
    ViewData["Title"] = "Quản lý Độc giả";
}

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Danh sách độc giả</h3>
        <a asp-action="Create" class="btn btn-success btn-sm ms-auto">
            <i class="bi bi-plus-circle"></i> Thêm độc giả
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Họ và Tên</th>
                    <th>Số điện thoại</th>
                    <th>Email</th>
                    <th>Địa chỉ</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.FullName</td>
                            <td>@item.PhoneNumber</td>
                            <td>@item.Email</td>
                            <td>@item.Address</td>
                            <td>
                                <a asp-controller="DocGia" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Sửa</a>
                                <a asp-controller="DocGia" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Xóa độc giả này?');">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center py-3">Chưa có dữ liệu độc giả.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>