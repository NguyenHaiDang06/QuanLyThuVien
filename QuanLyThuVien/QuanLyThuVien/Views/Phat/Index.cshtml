@model IEnumerable<QuanLyThuVien.Models.Penalty>
@{ Layout = "_MyLayout"; ViewData["Title"] = "Quản lý Tiền phạt"; }
<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Danh sách tiền phạt</h3>
        <a asp-action="Create" class="btn btn-success btn-sm ms-auto"><i class="bi bi-plus-circle"></i> Thêm mới</a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr><th>ID</th><th>Độc giả</th><th>Lý do</th><th>Số tiền</th><th>Trạng thái</th><th>Thao tác</th></tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any()) {
                    foreach (var item in Model) {
                        <tr>
                            <td>@item.Id</td><td>@item.ReaderName</td><td>@item.Reason</td><td>@item.Amount.ToString("N0")</td>
                            <td>@(item.IsPaid ? "Đã nộp" : "Chưa nộp")</td>
                            <td>
                                <a asp-controller="Phat" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">Sửa</a>
                                <a asp-controller="Phat" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Xóa khoản phạt này?');">Xóa</a>
                            </td>
                        </tr>
                    }
                } else {
                    <tr><td colspan="6" class="text-center py-3">Chưa có dữ liệu.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>