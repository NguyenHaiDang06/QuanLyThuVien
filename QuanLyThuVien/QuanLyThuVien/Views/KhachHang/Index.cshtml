@model IEnumerable<QuanLyThuVien.Models.Book>
@{
    Layout = "_LayoutKhach";
    ViewData["Title"] = "Tra cứu sách";
}

<div class="text-center mb-4">
    <h2 class="text-primary fw-bold">Khám phá kho sách</h2>
    <p class="text-muted">Tìm kiếm và tra cứu hàng ngàn đầu sách tại thư viện</p>
</div>

<form asp-action="Index" method="get" class="d-flex justify-content-center mb-5">
    <input type="text" name="searchString" class="form-control me-2 w-50 shadow-sm" placeholder="Nhập tên sách hoặc tác giả..." />
    <button type="submit" class="btn btn-primary shadow-sm"><i class="bi bi-search"></i> Tìm kiếm</button>
</form>

<div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
    @if (Model != null && Model.Any())
    {
        foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center">
                        <i class="bi bi-book text-primary" style="font-size: 3rem;"></i>
                        <h5 class="card-title mt-3 fw-bold">@item.Title</h5>
                        <p class="card-text text-muted mb-1"><i class="bi bi-person"></i> @item.Author</p>
                        <p class="card-text text-muted"><i class="bi bi-tags"></i> @item.Category</p>
                    </div>
                    <div class="card-footer bg-white border-0 text-center pb-3">
                        @if (item.Quantity > 0)
                        {
                            <span class="badge bg-success">Còn @item.Quantity quyển</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Đã hết sách</span>
                        }
                    </div>
                </div>
            </div>
        }
    }
    else
    {
        <div class="col-12 text-center text-danger">Không tìm thấy đầu sách nào phù hợp.</div>
    }
</div>