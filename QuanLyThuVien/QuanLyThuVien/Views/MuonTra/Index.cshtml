@model IEnumerable<QuanLyThuVien.Models.BorrowRecord>
@{
    Layout = "_MyLayout";
    ViewData["Title"] = "Quản lý Mượn - Trả";
}

<div class="card mt-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Danh sách phiếu mượn</h3>
        <a href="/MuonTra/Create" class="btn btn-success btn-sm ms-auto">
            <i class="bi bi-plus-circle"></i> Thêm phiếu mượn
        </a>
    </div>
    <div class="card-body p-0">
        <table class="table table-striped table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Tên Sách</th>
                    <th>Người Mượn</th>
                    <th>Ngày Mượn</th>
                    <th>Ngày Trả</th>
                    <th>Trạng Thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Id</td>
                            <td>@item.BookName</td>
                            <td>@item.ReaderName</td>
                            <td>@item.BorrowDate.ToString("dd/MM/yyyy")</td>
                            <td>@(item.ReturnDate.HasValue ? item.ReturnDate.Value.ToString("dd/MM/yyyy") : "Chưa trả")</td>
                            <td>
                                @if(item.Status == "Đang mượn")
                                {
                                    <span class="badge bg-warning text-dark">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@item.Status</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="MuonTra" asp-action="Edit" asp-route-id="@item.Id" class="btn btn-primary btn-sm">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <a asp-controller="MuonTra" asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm" onclick="return confirm('Bạn có chắc muốn xóa phiếu mượn này?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-3">Chưa có dữ liệu mượn trả nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>